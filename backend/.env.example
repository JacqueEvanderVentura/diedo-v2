# Copy to .env. This file contains development-only values.
APP_ENV=development
PROJECT_NAME=ERP API
API_VERSION=0.1.0
LOG_LEVEL=INFO

# Comma-separated browser origins. Keep production origins explicit.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local PostgreSQL from docker-compose.yml.
DATABASE_URL=postgresql+psycopg://erp:erp@localhost:5433/erp
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30

# Generate a random value with at least 32 characters. Never reuse this placeholder in production.
JWT_SECRET_KEY=replace-with-a-random-local-secret-of-at-least-32-characters
JWT_ISSUER=erp-api
JWT_AUDIENCE=erp-clients
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Direct backend path. Vite rewrites it to /api-backend/api/v1/auth for the browser-facing proxy.
REFRESH_COOKIE_PATH=/api/v1/auth

# Optional. The local bootstrap sets this password once when the owner has no password yet.
LOCAL_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-local-only-password

# Canonical demo fixtures are opt-in and never load as a startup side effect.
DEMO_SEED_ENABLED=false
EXPECTED_SCHEMA_REVISION=20260831_0012

# Local development attachment adapter. Production can replace it behind the same service port.
ATTACHMENT_STORAGE_ROOT=.local/attachments
ATTACHMENT_MAX_BYTES=10485760

# Temporary incident evidence policy. Bytes live in PostgreSQL until object hosting is selected.
INCIDENT_IMAGE_MAX_BYTES=5242880
INCIDENT_IMAGE_MAX_FILES=5
