# SerpAPI — primary search provider (free tier ~250/mes, ~50/hora)
SERPAPI_KEY=

# Serper.dev — failover cuando se agote cuota SerpAPI (opcional hasta tener token)
SERPER_API_KEY=

# Backend API (Vite proxy → http://127.0.0.1:8000)
VITE_API_BASE_URL=/api-backend

# Must mirror backend DEMO_SEED_ENABLED for an explicit demo build.
VITE_DEMO_SEED_ENABLED=false

# Production capability flags. They default to false in production and true in local development.
VITE_FEATURE_SELF_BOOKING=false
VITE_FEATURE_INVITATIONS=false
VITE_FEATURE_CRM_DISCOVERY=false
VITE_FEATURE_PAYROLL=false
VITE_FEATURE_PERFORMANCE=false
VITE_FEATURE_NOTIFICATIONS=false
VITE_FEATURE_CALENDAR_SCHEDULES=false
VITE_FEATURE_REGIONAL_MODULES=false
