FROM node:22-alpine AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

ARG VITE_API_BASE_URL
ARG VITE_DEMO_SEED_ENABLED=false
ARG VITE_FEATURE_SELF_BOOKING=false
ARG VITE_FEATURE_INVITATIONS=false
ARG VITE_FEATURE_CRM_DISCOVERY=false
ARG VITE_FEATURE_PAYROLL=false
ARG VITE_FEATURE_PERFORMANCE=false
ARG VITE_FEATURE_NOTIFICATIONS=false
ARG VITE_FEATURE_CALENDAR_SCHEDULES=false
ARG VITE_FEATURE_REGIONAL_MODULES=false

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_DEMO_SEED_ENABLED=${VITE_DEMO_SEED_ENABLED} \
    VITE_FEATURE_SELF_BOOKING=${VITE_FEATURE_SELF_BOOKING} \
    VITE_FEATURE_INVITATIONS=${VITE_FEATURE_INVITATIONS} \
    VITE_FEATURE_CRM_DISCOVERY=${VITE_FEATURE_CRM_DISCOVERY} \
    VITE_FEATURE_PAYROLL=${VITE_FEATURE_PAYROLL} \
    VITE_FEATURE_PERFORMANCE=${VITE_FEATURE_PERFORMANCE} \
    VITE_FEATURE_NOTIFICATIONS=${VITE_FEATURE_NOTIFICATIONS} \
    VITE_FEATURE_CALENDAR_SCHEDULES=${VITE_FEATURE_CALENDAR_SCHEDULES} \
    VITE_FEATURE_REGIONAL_MODULES=${VITE_FEATURE_REGIONAL_MODULES}

RUN npm run build

FROM caddy:2.10-alpine

COPY frontend/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv

EXPOSE 8080
